{
  "name": "MyXPNS",
  "short_name": "MyXPNS",
  "description": "Simple, private expense and receipt tracking in your own Google Sheet.",
  "id": "/",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f5f7",
  "theme_color": "#f5f5f7",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Money Spent", "url": "/#/add/spent", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Money Received", "url": "/#/add/received", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
