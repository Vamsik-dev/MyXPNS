# Copy to .env.local (development), .env.staging (staging) or .env.production (production).
# None of these values are secrets in the cryptographic sense (they ship to the browser),
# but they are environment-specific and must not be committed.

# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
# Leave empty to run in demo mode only.
VITE_GOOGLE_CLIENT_ID=

# Optional: enables "Connect an existing sheet" via Google Picker.
# API key restricted to HTTP referrers of this environment + Google Picker API.
VITE_GOOGLE_API_KEY=
# Google Cloud project NUMBER (not ID). Required by the Picker together with the API key.
VITE_GOOGLE_APP_ID=

# development | staging | production (shown in the UI outside production)
VITE_APP_ENV=development
